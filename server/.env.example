# ---- Server ----
PORT=4000
# Comma separated list of allowed browser origins (your website URL)
CORS_ORIGIN=http://localhost:3000

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aakarshit
# Set to true if your hosted Postgres needs SSL (Neon, Supabase, Render, etc.)
PGSSL=false

# ---- Admin login (created / updated when you run `npm run migrate`) ----
ADMIN_EMAIL=akarshitenterprises123@gmail.com
ADMIN_PASSWORD=change-this-strong-password
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Email (enquiry notifications go to ENQUIRY_TO) ----
# For Gmail: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=akarshitenterprises123@gmail.com
SMTP_PASS=your-16-character-app-password
ENQUIRY_TO=akarshitenterprises123@gmail.com

# ---- Uploads (optional) ----
# Where gallery images are stored. Use a persistent disk in production.
# UPLOAD_DIR=./uploads
